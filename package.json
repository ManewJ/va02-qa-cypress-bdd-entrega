{
  "name": "va02-qa-bdd-cypress",
  "version": "1.0.0",
  "description": "Projeto VA02 de QA - Automação BDD com Cypress + Cucumber + Gherkin - Portal da Transparência Gov.br",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:feature": "cypress run --spec 'cypress/e2e/features/**/*.feature'"
  },
  "devDependencies": {
    "cypress": "^13.6.0",
    "@badeball/cypress-cucumber-preprocessor": "^20.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
    "esbuild": "^0.20.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/e2e/steps/**/*.js"
  }
}